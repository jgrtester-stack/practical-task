{
  "name": "playwright-test-ts",
  "version": "1.0.0",
  "description": "Playwright Test + TypeScript + Allure test automation framework",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --project=chromium --grep \"@smoke\"",
    "test:regression": "playwright test --project=chromium --grep \"@regression\"",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm-run-all report:generate report:open",
    "smoke:report": "npm-run-all --continue-on-error test:smoke report",
    "regression:report": "npm-run-all --continue-on-error test:regression report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.0",
    "dotenv": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  }
}
